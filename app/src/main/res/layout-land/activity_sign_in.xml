<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screensBackgroundColor"
    tools:context="activities.SignInActivity">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/firstIB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-150dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/sign_in_and_sign_up_activities_image_buttons_default_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/secondIB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-150dp"
        android:layout_marginBottom="-150dp"
        android:background="@drawable/sign_in_and_sign_up_activities_image_buttons_default_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/signInSV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbarThumbVertical="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/secondIB"
        app:layout_constraintStart_toEndOf="@id/firstIB"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_5sdp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/signInTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_text"
                android:textAllCaps="false"
                android:textColor="@color/defaultColor"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                app:fontFamily="@font/cabin_medium"
                app:layout_constraintBottom_toTopOf="@id/userNameTIL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/userNameTIL"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColorHint="@color/subColor"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@null"
                app:errorEnabled="true"
                app:layout_constraintBottom_toTopOf="@id/passwordTIL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/signInTV"
                app:startIconDrawable="@drawable/user_name_edit_text_icon"
                app:startIconTint="@color/defaultColor">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/userNameTIET"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/username_e_mail_text"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textColor="@color/blackAndWhiteViewsColor"
                    android:textCursorDrawable="@null"
                    app:fontFamily="@font/cabin_medium" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordTIL"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColorHint="@color/subColor"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@null"
                app:boxStrokeErrorColor="@color/defaultColor"
                app:counterEnabled="true"
                app:counterMaxLength="10"
                app:counterTextColor="@color/defaultColor"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/defaultColor"
                app:errorEnabled="true"
                app:errorTextColor="@color/subColor"
                app:layout_constraintBottom_toTopOf="@id/rememberMeCB"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userNameTIL"
                app:startIconDrawable="@drawable/password_icon"
                app:startIconTint="@color/defaultColor">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordTIET"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password_text"
                    android:imeOptions="actionGo"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textColor="@color/blackAndWhiteViewsColor"
                    android:textCursorDrawable="@null"
                    app:fontFamily="@font/cabin_medium" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/rememberMeCB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remember_me_text"
                android:textAllCaps="false"
                android:textColor="@color/blackAndWhiteViewsColor"
                app:buttonTint="@color/defaultColor"
                app:fontFamily="@font/cabin_medium"
                app:layout_constraintBottom_toTopOf="@id/signInButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/passwordTIL" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10ssp"
                android:stateListAnimator="@null"
                android:text="@string/sign_in_text"
                android:textAllCaps="false"
                android:textColor="@color/whiteColor"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold"
                app:backgroundTint="@color/positive_buttons_pressed_and_unpressed_states_background"
                app:cornerRadius="@dimen/_7sdp"
                app:fontFamily="@font/cabin_medium"
                app:layout_constraintBottom_toTopOf="@id/forgotPasswordTV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rememberMeCB" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/forgotPasswordTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_5sdp"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_3sdp"
                android:text="@string/forgot_password_text"
                android:textAllCaps="false"
                android:textColor="@color/subColor"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                app:fontFamily="@font/cabin_medium"
                app:layout_constraintBottom_toTopOf="@id/signUpTV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/signInButton" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/dontHaveAnAccountTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/don_t_have_an_account_text"
                android:textAllCaps="false"
                android:textColor="@color/subColor"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                app:fontFamily="@font/cabin_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/signUpTV"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forgotPasswordTV" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/signUpTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_3sdp"
                android:text="@string/sign_up_text"
                android:textAllCaps="false"
                android:textColor="@color/defaultColor"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                app:fontFamily="@font/cabin_medium"
                app:layout_constraintBaseline_toBaselineOf="@id/dontHaveAnAccountTV"
                app:layout_constraintBottom_toBottomOf="@id/dontHaveAnAccountTV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/dontHaveAnAccountTV"
                app:layout_constraintTop_toTopOf="@id/dontHaveAnAccountTV" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/dontHaveAnAccountSignUpAccountGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="dontHaveAnAccountTV, signUpTV" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>