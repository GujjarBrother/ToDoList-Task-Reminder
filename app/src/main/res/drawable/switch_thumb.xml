<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:state_checked="true">

        <shape
            android:shape="oval">

            <solid
                android:color="@color/whiteColor"/>

            <size
                android:width="@dimen/_13sdp"
                android:height="@dimen/_13sdp"/>

            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/defaultColor"/>

        </shape>

    </item>

    <item
        android:state_checked="false">

        <shape
            android:shape="oval">

            <solid
                android:color="@color/whiteColor"/>

            <size
                android:width="@dimen/_13sdp"
                android:height="@dimen/_13sdp"/>

            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/switchTrackOffColor"/>

        </shape>

    </item>

</selector>