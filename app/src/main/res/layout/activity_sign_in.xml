<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screensBackgroundColor"
    tools:context="com.todo.list.activities.SignInActivity">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/firstIB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/sign_in_and_sign_up_activities_image_buttons_default_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/secondIB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-150dp"
        android:background="@drawable/sign_in_and_sign_up_activities_image_buttons_default_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/thirdIB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-100dp"
        android:layout_marginBottom="-90dp"
        android:background="@drawable/sign_in_and_sign_up_activities_image_buttons_default_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/fourthIB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-150dp"
        android:background="@drawable/sign_in_and_sign_up_activities_image_buttons_default_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/signInTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sign_in_text"
        android:textAllCaps="false"
        android:textColor="@color/defaultColor"
        android:textSize="@dimen/_23ssp"
        android:textStyle="bold"
        android:fontFamily="@font/cabin_medium"
        app:layout_constraintBottom_toTopOf="@id/signInCV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/secondIB" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/signInCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        app:cardBackgroundColor="@color/whiteColor"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_2sdp"
        app:strokeColor="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/thirdIB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstIB">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/userNameTIL"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:background="@android:color/transparent"
                android:textColorHint="#9E9E9E"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@null"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/user_name_edit_text_icon"
                app:startIconTint="@color/defaultColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/userNameTIET"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/username_e_mail_text"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:textAllCaps="false"
                    android:fontFamily="@font/cabin_medium"
                    android:textColor="@color/blackColor" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordTIL"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:background="@android:color/transparent"
                android:textColorHint="#9E9E9E"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@null"
                app:boxStrokeErrorColor="@color/defaultColor"
                app:counterEnabled="true"
                app:counterMaxLength="10"
                app:counterTextColor="@color/defaultColor"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/defaultColor"
                app:errorEnabled="true"
                app:errorTextColor="#9E9E9E"
                app:startIconDrawable="@drawable/password_icon"
                app:startIconTint="@color/defaultColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userNameTIL"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordTIET"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password_text"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textAllCaps="false"
                    android:fontFamily="@font/cabin_medium"
                    android:textColor="@color/blackColor" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/rememberMeCB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cabin_medium"
                android:text="@string/remember_me_text"
                android:textAllCaps="false"
                app:buttonTint="@color/defaultColor"
                android:textColor="@color/blackColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/passwordTIL" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/_200sdp"
                android:minHeight="@dimen/_55sdp"
                app:cornerRadius="@dimen/_7sdp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/defaultColor"
                android:padding="@dimen/_10ssp"
                android:stateListAnimator="@null"
                android:text="@string/sign_in_text"
                android:textAllCaps="false"
                android:fontFamily="@font/cabin_medium"
                android:textColor="@color/whiteColor"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rememberMeCB"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/forgotPasswordTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/_5sdp"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_3sdp"
                android:text="@string/forgot_password_text"
                android:textAllCaps="false"
                android:fontFamily="@font/cabin_medium"
                android:textColor="@color/purple_500"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/signInButton"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/dontHaveAnAccountTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/don_t_have_an_account_text"
                android:textAllCaps="false"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/cabin_medium"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forgotPasswordTV"
                app:layout_constraintEnd_toStartOf="@id/signUpTV"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/signUpTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_3sdp"
                android:text="@string/sign_up_text"
                android:textAllCaps="false"
                android:textColor="@color/defaultColor"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/cabin_medium"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/dontHaveAnAccountTV"
                app:layout_constraintTop_toBottomOf="@id/forgotPasswordTV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/dontHaveAnAccountSignUpAccountGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="dontHaveAnAccountTV, signUpTV"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>