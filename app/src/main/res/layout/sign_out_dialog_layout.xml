<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_boxes_background"
    android:paddingHorizontal="@dimen/_10sdp"
    android:paddingBottom="@dimen/_8sdp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/signOutIV"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        app:layout_constraintBottom_toTopOf="@id/signOutMessageTV"
        app:srcCompat="@drawable/sign_out_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/defaultColor" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/signOutMessageTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/are_you_sure_you_want_to_sign_out_text"
        android:textAllCaps="false"
        android:fontFamily="@font/cabin_medium"
        android:textSize="@dimen/_15ssp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_5sdp"
        android:textColor="@color/blackAndWhiteViewsColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/noButton"
        app:layout_constraintTop_toBottomOf="@id/signOutIV" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/noButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:backgroundTint="@android:color/transparent"
        android:fontFamily="@font/cabin_medium"
        android:minHeight="@dimen/_50sdp"
        android:stateListAnimator="@null"
        android:text="@string/no_text"
        android:textAllCaps="false"
        android:textColor="@color/defaultColor"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/yesButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signOutMessageTV"
        app:strokeColor="@color/defaultColor"
        app:strokeWidth="@dimen/_1sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/yesButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:backgroundTint="@color/defaultColor"
        android:fontFamily="@font/cabin_medium"
        android:minHeight="@dimen/_50sdp"
        android:stateListAnimator="@null"
        android:text="@string/yes_text"
        android:textAllCaps="false"
        android:textColor="@color/whiteColor"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/noButton"
        app:layout_constraintTop_toBottomOf="@id/signOutMessageTV" />

</androidx.constraintlayout.widget.ConstraintLayout>