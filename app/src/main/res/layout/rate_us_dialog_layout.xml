<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_boxes_light_mode_background"
    android:paddingBottom="@dimen/_8sdp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbarThumbVertical="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_5sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dismissRateUsDialogIV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                android:src="@drawable/cross_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/rateUsDialogIV"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/rateUsDialogIV"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:src="@drawable/rate_us_dialog_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/rateOurAppTV"
                app:layout_constraintTop_toBottomOf="@id/dismissRateUsDialogIV" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/rateOurAppTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/rate_our_app_text"
                android:textAllCaps="false"
                android:fontFamily="@font/cabin_medium"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                android:textColor="@color/blackAndWhiteViewsColor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/messageTV"
                app:layout_constraintTop_toBottomOf="@id/rateUsDialogIV" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/messageTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center"
                android:text="@string/rate_us_message_text"
                android:textAllCaps="false"
                android:fontFamily="@font/cabin_medium"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/blackAndWhiteViewsColor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/ratingBar"
                app:layout_constraintTop_toBottomOf="@id/rateOurAppTV" />

            <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:numStars="5"
                android:progressBackgroundTint="#BDBDBD"
                android:progressTint="@color/defaultColor"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:stepSize="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/rateUsButton"
                app:layout_constraintTop_toBottomOf="@id/messageTV" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rateUsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:backgroundTint="@color/defaultColor"
                android:gravity="center"
                android:minWidth="@dimen/_200sdp"
                android:minHeight="@dimen/_55sdp"
                android:stateListAnimator="@null"
                android:text="@string/rate_us_text"
                android:textAllCaps="false"
                android:fontFamily="@font/cabin_medium"
                android:textColor="@color/whiteColor"
                android:textSize="@dimen/_14ssp"
                app:cornerRadius="@dimen/_7sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ratingBar" />

            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="#D9D9D9"
                app:layout_constraintEnd_toEndOf="@id/rateUsButton"
                app:layout_constraintStart_toStartOf="@id/rateUsButton"
                app:layout_constraintTop_toBottomOf="@id/ratingBar" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/thanksForYourFeedbackTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center"
                android:text="@string/thanks_for_your_feedback_text"
                android:textAllCaps="false"
                android:textColor="@color/blackColor"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/cabin_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="view,
                thanksForYourFeedbackTV" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>