<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sortingDialogRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_boxes_light_mode_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:scrollbarThumbVertical="@android:color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/sort_by_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_by_text"
                android:textAllCaps="false"
                android:textColor="@color/defaultColor"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioGroup
                android:id="@+id/sort_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sort_by_text_view">

                <RadioButton
                    android:id="@+id/title_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/title_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

                <RadioButton
                    android:id="@+id/day_of_week_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/day_of_week_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

                <RadioButton
                    android:id="@+id/date_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/date_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

                <RadioButton
                    android:id="@+id/month_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/month_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

                <RadioButton
                    android:id="@+id/year_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/year_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

                <RadioButton
                    android:id="@+id/time_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/time_hint"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

            </RadioGroup>

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="#80E0E0E0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sort_radio_group" />

            <RadioGroup
                android:id="@+id/ascending_descending_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <RadioButton
                    android:id="@+id/ascending_a_to_z_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/ascending_a_z_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

                <RadioButton
                    android:id="@+id/descending_z_to_a_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/defaultColor"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:text="@string/descending_z_a_text"
                    android:textAllCaps="false"
                    android:textColor="@color/blackColor"
                    android:textSize="@dimen/_12ssp" />

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dialog_boxes_buttons_light_mode_default_background"
                android:text="@string/sort_text"
                android:textAllCaps="false"
                android:textColor="@color/blackColor"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ascending_descending_radio_group" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_3sdp"
                android:background="@drawable/dialog_boxes_buttons_light_mode_default_background"
                android:text="@string/cancel_text"
                android:textAllCaps="false"
                android:textColor="@color/blackColor"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="@id/sort_button"
                app:layout_constraintEnd_toStartOf="@id/sort_button"
                app:layout_constraintTop_toTopOf="@id/sort_button" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>