<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/screensBackgroundColor"
    app:cardCornerRadius="@dimen/_10sdp"
    app:strokeColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingBottom="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dismissDialogIV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toTopOf="@id/resetPasswordTitleTV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cross_image" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/resetPasswordTitleTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/reset_password_text"
            android:textAllCaps="false"
            android:textColor="@color/defaultColor"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            app:fontFamily="@font/cabin_medium"
            app:layout_constraintBottom_toTopOf="@id/securityQuestionAnswerTIL"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dismissDialogIV" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/securityQuestionAnswerTIL"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@android:color/transparent"
            android:textColorHint="@color/subColor"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxStrokeColor="@null"
            app:errorEnabled="true"
            app:layout_constraintBottom_toTopOf="@id/resetPasswordButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resetPasswordTitleTV"
            app:startIconDrawable="@drawable/security_question_answer_icon"
            app:startIconTint="@color/defaultColor">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/securityQuestionAnswerTIET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionGo"
                android:inputType="textCapWords"
                android:textAllCaps="false"
                android:textColor="@color/blackAndWhiteViewsColor"
                android:textCursorDrawable="@null"
                app:fontFamily="@font/cabin_medium" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetPasswordButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="@dimen/_200sdp"
            android:minHeight="@dimen/_55sdp"
            android:padding="@dimen/_10ssp"
            android:stateListAnimator="@null"
            android:text="@string/reset_text"
            android:textAllCaps="false"
            android:textColor="@color/whiteColor"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            app:backgroundTint="@color/positive_buttons_pressed_and_unpressed_states_background"
            app:cornerRadius="@dimen/_7sdp"
            app:fontFamily="@font/cabin_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/securityQuestionAnswerTIL" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>